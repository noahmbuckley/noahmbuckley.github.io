{
  "task_id": "disaster-A",
  "name": "Disaster — type + deaths + severity (50)",
  "version": "2026-06-14",
  "id_field": "item_id",
  "instructions": "All 50 are confirmed disasters/accidents. Three quick checks per item. (1) TYPE: yellow = the LLM's type; leave blank if right, else pick the better one. (2) DEATHS: is the LLM's human death count right? It's usually stated in the text — fast to check. Leave blank if right; if wrong, type the correct number. (3) SEVERITY: just an EYEBALL — is the LLM's low/med/high obviously off given the deaths/affected? Blank = it's fine (the default); only flag clear misses; 'don't know' is totally fine (severity is judgment-heavy — the LLM owns it, you're just spot-checking).",
  "display": [
    { "field": "strata", "label": "Strata", "format": "tag" },
    { "field": "date", "label": "Date" },
    { "field": "region", "label": "Region", "format": "compact" },
    { "field": "text", "label": "Event (RU)", "format": "longtext" },
    { "field": "haiku_type", "label": "LLM: TYPE", "format": "compact", "highlight": "llm" },
    { "field": "haiku_deaths", "label": "LLM: deaths", "format": "compact" },
    { "field": "affected", "label": "LLM: affected", "format": "compact" },
    { "field": "haiku_severity", "label": "LLM: severity", "format": "compact" },
    { "field": "id", "label": "id", "format": "compact" }
  ],
  "validation": [
    {
      "field": "type_correct",
      "label": "Is the TYPE correct?",
      "type": "enum",
      "required": true,
      "options": [
        { "value": "yes", "label": "Yes", "key": "1", "tone": "good" },
        { "value": "no", "label": "No", "key": "2", "tone": "bad" },
        { "value": "cant_tell", "label": "Can't tell", "key": "3", "tone": "neutral" }
      ]
    },
    {
      "field": "correct_type",
      "label": "Correct type (if wrong)",
      "type": "enum",
      "options": [
        { "value": "fire", "label": "fire", "tone": "neutral" },
        { "value": "disease_outbreak", "label": "disease_outbreak", "tone": "neutral" },
        { "value": "infrastructure_failure", "label": "infrastructure_failure", "tone": "neutral" },
        { "value": "environmental_contamination", "label": "environmental_contamination", "tone": "neutral" },
        { "value": "mass_poisoning", "label": "mass_poisoning", "tone": "neutral" },
        { "value": "transport_accident", "label": "transport_accident", "tone": "neutral" },
        { "value": "building_collapse", "label": "building_collapse", "tone": "neutral" },
        { "value": "heating_failure", "label": "heating_failure", "tone": "neutral" },
        { "value": "explosion", "label": "explosion", "tone": "neutral" },
        { "value": "gas_explosion", "label": "gas_explosion", "tone": "neutral" },
        { "value": "water_supply", "label": "water_supply", "tone": "neutral" },
        { "value": "flood", "label": "flood", "tone": "neutral" },
        { "value": "industrial_accident", "label": "industrial_accident", "tone": "neutral" },
        { "value": "military_accident", "label": "military_accident", "tone": "neutral" },
        { "value": "plane_crash", "label": "plane_crash", "tone": "neutral" },
        { "value": "drought", "label": "drought", "tone": "neutral" },
        { "value": "mine_accident", "label": "mine_accident", "tone": "neutral" },
        { "value": "mass_shooting", "label": "mass_shooting", "tone": "neutral" },
        { "value": "storm", "label": "storm", "tone": "neutral" },
        { "value": "other_disaster", "label": "other_disaster", "tone": "neutral" }
      ],
      "show_if": { "type_correct": ["no"] }
    },
    {
      "field": "deaths_correct",
      "label": "Is the death count right?",
      "type": "enum",
      "required": true,
      "options": [
        { "value": "yes", "label": "Yes", "key": "4", "tone": "good" },
        { "value": "no", "label": "No", "key": "5", "tone": "bad" },
        { "value": "cant_tell", "label": "Can't tell", "key": "6", "tone": "neutral" }
      ]
    },
    {
      "field": "correct_deaths",
      "label": "Correct death count (if wrong)",
      "type": "text",
      "placeholder": "number",
      "show_if": { "deaths_correct": ["no"] }
    },
    {
      "field": "severity_ok",
      "label": "LLM severity look OK? (blank = fine)",
      "type": "enum",
      "options": [
        { "value": "yes", "label": "Fine", "tone": "good" },
        { "value": "no", "label": "Obviously off", "tone": "bad" },
        { "value": "cant_tell", "label": "Don't know", "tone": "neutral" }
      ]
    },
    {
      "field": "notes",
      "label": "Notes",
      "type": "textarea",
      "placeholder": "Free text — surprises, edge cases, anything"
    }
  ]
}
