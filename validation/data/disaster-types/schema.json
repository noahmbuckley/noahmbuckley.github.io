{
  "task_id": "disaster-types",
  "name": "Disaster — type + severity gold (100 items)",
  "version": "2026-05-26",
  "id_field": "item_id",
  "instructions": "100 events confirmed to BE disasters (we're not re-asking yes/no). Goal: hand-correct the disaster TYPE and SEVERITY labels — both currently have 0 gold and the model has nothing to score against. Yellow = LLM's current call. Just confirm it's right, or pick the correct one. SEVERITY rubric: HIGH = ≥5 deaths or mass evacuation or ≥3-day emergency regime; MEDIUM = 1-4 deaths or major disruption; LOW = property damage only.",
  "display": [
    {
      "field": "strata",
      "label": "Strata",
      "format": "tag"
    },
    {
      "field": "date",
      "label": "Date"
    },
    {
      "field": "region",
      "label": "Region"
    },
    {
      "field": "regionid",
      "label": "regionid",
      "format": "compact"
    },
    {
      "field": "eventdesc",
      "label": "Event (RU)",
      "format": "longtext"
    },
    {
      "field": "disaster_type",
      "label": "disaster_type",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "severity",
      "label": "severity",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "deaths",
      "label": "deaths (LLM)",
      "format": "compact"
    }
  ],
  "validation": [
    {
      "field": "type_correct",
      "label": "Is disaster_type correct?",
      "type": "enum",
      "required": true,
      "options": [
        {
          "value": "yes",
          "label": "Yes",
          "tone": "good",
          "key": "1"
        },
        {
          "value": "no",
          "label": "No — pick correct below",
          "tone": "bad",
          "key": "2"
        },
        {
          "value": "borderline",
          "label": "Borderline / overlap",
          "tone": "warn",
          "key": "3"
        },
        {
          "value": "not_a_disaster",
          "label": "Not a disaster (FP)",
          "tone": "bad",
          "key": "4"
        }
      ]
    },
    {
      "field": "correct_type",
      "label": "If 'no': correct type",
      "type": "enum",
      "options": [
        {
          "value": "fire",
          "label": "fire",
          "tone": "neutral"
        },
        {
          "value": "disease_outbreak",
          "label": "disease_outbreak",
          "tone": "neutral"
        },
        {
          "value": "infrastructure_failure",
          "label": "infrastructure_failure",
          "tone": "neutral"
        },
        {
          "value": "mass_poisoning",
          "label": "mass_poisoning",
          "tone": "neutral"
        },
        {
          "value": "environmental_contamination",
          "label": "environmental_contamination",
          "tone": "neutral"
        },
        {
          "value": "transport_accident",
          "label": "transport_accident",
          "tone": "neutral"
        },
        {
          "value": "building_collapse",
          "label": "building_collapse",
          "tone": "neutral"
        },
        {
          "value": "explosion",
          "label": "explosion",
          "tone": "neutral"
        },
        {
          "value": "heating_failure",
          "label": "heating_failure",
          "tone": "neutral"
        },
        {
          "value": "water_supply",
          "label": "water_supply",
          "tone": "neutral"
        },
        {
          "value": "industrial_accident",
          "label": "industrial_accident",
          "tone": "neutral"
        },
        {
          "value": "flood",
          "label": "flood",
          "tone": "neutral"
        },
        {
          "value": "gas_explosion",
          "label": "gas_explosion",
          "tone": "neutral"
        },
        {
          "value": "military_accident",
          "label": "military_accident",
          "tone": "neutral"
        },
        {
          "value": "wildfire",
          "label": "wildfire",
          "tone": "neutral"
        },
        {
          "value": "other_disaster",
          "label": "other_disaster",
          "tone": "neutral"
        }
      ],
      "show_if": {
        "type_correct": [
          "no",
          "borderline"
        ]
      }
    },
    {
      "field": "correct_severity",
      "label": "Correct severity",
      "type": "enum",
      "required": true,
      "options": [
        {
          "value": "low",
          "label": "LOW",
          "tone": "neutral",
          "key": "q"
        },
        {
          "value": "medium",
          "label": "MEDIUM",
          "tone": "warn",
          "key": "w"
        },
        {
          "value": "high",
          "label": "HIGH",
          "tone": "good",
          "key": "e"
        },
        {
          "value": "cant_tell",
          "label": "Can't tell from text",
          "tone": "neutral",
          "key": "r"
        }
      ]
    },
    {
      "field": "deaths_estimate",
      "label": "Deaths (if mentioned)",
      "type": "integer",
      "placeholder": "0 if none"
    },
    {
      "field": "notes",
      "label": "Notes / context",
      "type": "textarea"
    }
  ]
}
