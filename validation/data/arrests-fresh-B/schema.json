{
  "task_id": "arrests-fresh-B",
  "name": "Arrests — verify (100 items, edges)",
  "version": "2026-05-26",
  "id_field": "item_id",
  "instructions": "100-item refresh (2026-05-26). Focused on the HIGH-VALUE strata you didn't get to and fresh media-corpus picks. Pink-tinted rows are region-mismatch carry-forwards. Yellow = LLM's call. Multi-defendant collapse + federal-vs-regional ambiguity are the two recurring bugs to keep watching for.",
  "display": [
    {
      "field": "strata",
      "label": "Strata",
      "format": "tag"
    },
    {
      "field": "source",
      "label": "Source",
      "format": "compact"
    },
    {
      "field": "date",
      "label": "Date"
    },
    {
      "field": "region_event",
      "label": "regionid_event (LLM)",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "region_publisher",
      "label": "regionid_publisher",
      "format": "compact"
    },
    {
      "field": "text",
      "label": "Text (RU)",
      "format": "longtext"
    },
    {
      "field": "official_name",
      "label": "official_name",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "official_position",
      "label": "position",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "official_level",
      "label": "level",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "crime_type",
      "label": "crime_type",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "arrest_stage",
      "label": "arrest_stage",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "is_corruption",
      "label": "is_corruption",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "is_federal",
      "label": "is_federal",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "regionid_confidence",
      "label": "regionid_confidence",
      "format": "compact"
    },
    {
      "field": "item_id",
      "label": "item_id",
      "format": "compact"
    }
  ],
  "row_class_field": "region_mismatch_flag",
  "row_class_map": {
    "true": "fn-candidate",
    "TRUE": "fn-candidate"
  },
  "validation": [
    {
      "field": "verdict",
      "label": "Real arrest event of an official?",
      "type": "enum",
      "required": true,
      "options": [
        {
          "value": "YES",
          "label": "YES — real arrest",
          "key": "1",
          "tone": "good"
        },
        {
          "value": "NO",
          "label": "NO — not an arrest",
          "key": "2",
          "tone": "bad"
        },
        {
          "value": "BORDERLINE",
          "label": "BORDERLINE",
          "key": "3",
          "tone": "warn"
        },
        {
          "value": "SKIP",
          "label": "SKIP — can't tell",
          "key": "4",
          "tone": "neutral"
        }
      ]
    },
    {
      "field": "region_event_correct",
      "label": "Is the event-region correct?",
      "type": "enum",
      "options": [
        {
          "value": "yes",
          "label": "Yes",
          "key": "q",
          "tone": "good"
        },
        {
          "value": "no",
          "label": "No",
          "key": "w",
          "tone": "bad"
        },
        {
          "value": "cant_tell",
          "label": "Can't tell",
          "key": "e",
          "tone": "neutral"
        }
      ],
      "show_if": {
        "verdict": [
          "YES",
          "BORDERLINE"
        ]
      }
    },
    {
      "field": "correct_regionid",
      "label": "Correct regionid (if event-region wrong)",
      "type": "integer",
      "placeholder": "e.g. 18 for Moscow",
      "show_if": {
        "region_event_correct": [
          "no"
        ]
      }
    },
    {
      "field": "multi_defendant",
      "label": "Number of distinct defendants in this text",
      "type": "enum",
      "options": [
        {
          "value": "1",
          "label": "1",
          "tone": "neutral"
        },
        {
          "value": "2",
          "label": "2",
          "tone": "neutral"
        },
        {
          "value": "3plus",
          "label": "3+",
          "tone": "neutral"
        },
        {
          "value": "cant_tell",
          "label": "Can't tell",
          "tone": "neutral"
        }
      ],
      "show_if": {
        "verdict": [
          "YES",
          "BORDERLINE"
        ]
      }
    },
    {
      "field": "rejection_reason",
      "label": "Why not an arrest event?",
      "type": "enum",
      "options": [
        {
          "value": "not_an_arrest",
          "label": "Not an arrest (no detention/charges/etc.)",
          "key": "q",
          "tone": "neutral"
        },
        {
          "value": "not_an_official",
          "label": "Person is not an official",
          "key": "w",
          "tone": "neutral"
        },
        {
          "value": "rumor_threat",
          "label": "Rumor / threat / unconfirmed",
          "key": "e",
          "tone": "neutral"
        },
        {
          "value": "duplicate_or_followup",
          "label": "Duplicate / follow-up to earlier event",
          "key": "r",
          "tone": "neutral"
        },
        {
          "value": "no_info",
          "label": "Can't tell from text",
          "key": "t",
          "tone": "neutral"
        },
        {
          "value": "other",
          "label": "Other (use notes)",
          "key": "y",
          "tone": "neutral"
        }
      ],
      "show_if": {
        "verdict": [
          "NO"
        ]
      }
    },
    {
      "field": "notes",
      "label": "Notes",
      "type": "textarea",
      "placeholder": "Free text — surprises, edge cases, anything"
    }
  ]
}
