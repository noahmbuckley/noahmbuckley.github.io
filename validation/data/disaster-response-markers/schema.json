{
  "task_id": "disaster-response-markers",
  "name": "Disaster response-markers validation v2 (66)",
  "version": "2026-09-28",
  "id_field": "item_id",
  "instructions": "You are checking the Haiku (prompt v2) calls about how the authorities responded to ONE event. First: do the snippets describe THIS event? Then judge each YES call against the snippet the model cited (marked CITED). A YES is 'correct' only if the cited snippet is about THIS event and states the marker. Federal = president / RF government / federal minister / central apparatus of a federal agency -- a regional branch ('СУ СК по ... области', 'ГУ МЧС по ...') does not count. If every marker is 'unclear', say whether a response marker is nevertheless present (in the snippets or by searching). 'event date' is the date the model's window is anchored on; snippets cover 1 day before to 30 days after it. 'Can't tell' is fine -- don't guess.",
  "display": [
    {
      "field": "stratum",
      "label": "stratum",
      "format": "tag"
    },
    {
      "field": "year",
      "label": "year",
      "format": "compact"
    },
    {
      "field": "region",
      "label": "region",
      "format": "compact"
    },
    {
      "field": "disaster_type",
      "label": "type",
      "format": "compact"
    },
    {
      "field": "deaths",
      "label": "deaths",
      "format": "compact"
    },
    {
      "field": "event_date",
      "label": "event date (window anchor)",
      "format": "compact"
    },
    {
      "field": "fpp_text",
      "label": "FPP description (RU)",
      "format": "longtext"
    },
    {
      "field": "event_summary",
      "label": "Event summary the model was given",
      "format": "longtext"
    },
    {
      "field": "haiku_markers",
      "label": "Haiku v2 calls",
      "format": "longtext",
      "highlight": "llm"
    },
    {
      "field": "evidence_snippets",
      "label": "Snippets the model saw (cited first)",
      "format": "longtext"
    },
    {
      "field": "wiki_search_url",
      "label": "ru.wikipedia search",
      "format": "link"
    },
    {
      "field": "google_search_url",
      "label": "Google search",
      "format": "link"
    }
  ],
  "validation": [
    {
      "field": "snippet_matches_event",
      "label": "Do the snippets describe THIS event (not another incident)?",
      "type": "enum",
      "required": true,
      "options": [
        {
          "value": "yes",
          "label": "Yes, on-topic",
          "key": "1",
          "tone": "good"
        },
        {
          "value": "partial",
          "label": "Some on-topic, some not",
          "key": "2",
          "tone": "neutral"
        },
        {
          "value": "no",
          "label": "No / wrong event",
          "key": "3",
          "tone": "bad"
        }
      ]
    },
    {
      "field": "other_yes_correct",
      "label": "Other YES markers (governor, compensation, investigation, dismissal, mourning): correct?",
      "type": "enum",
      "required": true,
      "options": [
        {
          "value": "all_ok",
          "label": "All supported",
          "key": "4",
          "tone": "good"
        },
        {
          "value": "some_wrong",
          "label": "At least one not supported",
          "key": "5",
          "tone": "bad"
        },
        {
          "value": "na",
          "label": "No other YES shown",
          "key": "6",
          "tone": "neutral"
        }
      ]
    },
    {
      "field": "wrong_markers",
      "label": "Which YES markers are NOT supported? (comma list)",
      "type": "text",
      "placeholder": "e.g. federal_attention, compensation -- blank if none"
    },
    {
      "field": "missed_markers",
      "label": "Markers that ARE present (in the snippets shown, or found by search) but the model called unclear",
      "type": "text",
      "placeholder": "e.g. chs_declared, federal_attention -- blank if none"
    },
    {
      "field": "notes",
      "label": "Notes",
      "type": "textarea",
      "placeholder": "Free text"
    }
  ],
