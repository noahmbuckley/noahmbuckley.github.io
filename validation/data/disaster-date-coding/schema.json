{
  "task_id": "disaster-date-coding",
  "name": "Disaster — Day-precision date hand-coding (pre-2018 high-severity)",
  "version": "2026-05-12",
  "id_field": "eventid",
  "instructions": "For each event, find the actual day the disaster occurred and enter it as YYYY-MM-DD. The event description (RU) gives you keywords; the year and month are already known. Use Russian Wikipedia, lenta.ru, kommersant.ru, ria.ru, RIA Novosti, or city-specific news sites to look up the date. Paste the URL you used in 'source_url'. Use 'date_confidence' to flag whether the day is certain (multiple sources agree) or approximate (e.g., only month + 'first week' inferable). SKIP if you can't find anything after a few minutes.",
  "display": [
    {"field": "year_month", "label": "Year-month (known)", "format": "tag"},
    {"field": "region", "label": "Region"},
    {"field": "regionid", "label": "regionid", "format": "compact"},
    {"field": "eventdesc", "label": "Event description (RU)", "format": "longtext"},
    {"field": "disaster_type", "label": "disaster_type", "format": "compact", "highlight": "llm"},
    {"field": "deaths", "label": "deaths", "format": "compact", "highlight": "llm"},
    {"field": "severity_recal", "label": "severity_recal", "format": "compact", "highlight": "llm"},
    {"field": "search_hint", "label": "Search hints", "format": "longtext"},
    {"field": "stratum", "label": "Stratum", "format": "tag"},
    {"field": "eventid", "label": "eventid", "format": "compact"}
  ],
  "validation": [
    {
      "field": "outcome",
      "label": "Outcome",
      "type": "enum",
      "required": true,
      "options": [
        {"value": "FOUND",      "label": "FOUND — date below",      "key": "1", "tone": "good"},
        {"value": "NOT_FOUND",  "label": "NOT FOUND — searched but no date",  "key": "2", "tone": "warn"},
        {"value": "AMBIGUOUS",  "label": "AMBIGUOUS — multiple events match", "key": "3", "tone": "warn"},
        {"value": "SKIP",       "label": "SKIP — moving on",        "key": "4", "tone": "neutral"}
      ]
    },
    {
      "field": "event_date",
      "label": "Event date (YYYY-MM-DD)",
      "type": "text",
      "placeholder": "e.g. 2017-03-25",
      "show_if": {"outcome": ["FOUND","AMBIGUOUS"]}
    },
    {
      "field": "date_confidence",
      "label": "Date confidence",
      "type": "enum",
      "options": [
        {"value": "high",   "label": "HIGH — multiple sources agree on this exact day",   "key": "q", "tone": "good"},
        {"value": "medium", "label": "MEDIUM — one source, plausible",                    "key": "w", "tone": "neutral"},
        {"value": "low",    "label": "LOW — approximate / inferred",                      "key": "e", "tone": "warn"}
      ],
      "show_if": {"outcome": ["FOUND","AMBIGUOUS"]}
    },
    {
      "field": "source_url",
      "label": "Source URL (Wikipedia / news / etc.)",
      "type": "text",
      "placeholder": "https://...",
      "show_if": {"outcome": ["FOUND","AMBIGUOUS"]}
    },
    {
      "field": "deaths_corrected",
      "label": "Correct deaths (override the LLM if confirmed wrong)",
      "type": "integer",
      "placeholder": "leave blank if LLM was right or n/a"
    },
    {
      "field": "notes",
      "label": "Notes",
      "type": "textarea",
      "placeholder": "Free text — note disagreements, ambiguity, what you found"
    }
  ]
}
