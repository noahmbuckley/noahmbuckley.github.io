{
  "task_id": "protests-fresh-C",
  "name": "Protests — Shkulev media (100 items)",
  "version": "2026-05-27",
  "id_field": "item_id",
  "instructions": "Protest candidates from rusMedia Shkulev portal titles (see eventsData/code/17_rusmedia_protest_search.py). Stratified by year band, region size, detention-keyword, and borderline single-keyword matches. Verify each is a real protest event; flag where regionid_publisher doesn't match the event region.",
  "display": [
    {
      "field": "date",
      "label": "Date"
    },
    {
      "field": "region_label",
      "label": "regionid_publisher",
      "format": "compact"
    },
    {
      "field": "channel_or_portal",
      "label": "Source",
      "format": "compact"
    },
    {
      "field": "title",
      "label": "Title (RU)",
      "format": "longtext"
    },
    {
      "field": "text",
      "label": "Text (RU)",
      "format": "longtext"
    },
    {
      "field": "kw_core",
      "label": "Core kw",
      "format": "tag"
    },
    {
      "field": "kw_detention",
      "label": "Detention kw",
      "format": "tag"
    },
    {
      "field": "url",
      "label": "URL",
      "format": "link"
    },
    {
      "field": "strata",
      "label": "Strata",
      "format": "tag"
    }
  ],
  "validation": [
    {
      "field": "verdict",
      "label": "Is this a real protest event?",
      "type": "enum",
      "required": true,
      "options": [
        {
          "value": "YES",
          "label": "YES — real protest",
          "key": "1",
          "tone": "good"
        },
        {
          "value": "NO",
          "label": "NO — not a protest",
          "key": "2",
          "tone": "bad"
        },
        {
          "value": "BORDERLINE",
          "label": "BORDERLINE",
          "key": "3",
          "tone": "warn"
        },
        {
          "value": "SKIP",
          "label": "SKIP — can't tell",
          "key": "4",
          "tone": "neutral"
        }
      ]
    },
    {
      "field": "protest_type",
      "label": "Protest type",
      "type": "enum",
      "options": [
        {
          "value": "political",
          "label": "political"
        },
        {
          "value": "local_issue",
          "label": "local_issue"
        },
        {
          "value": "labor",
          "label": "labor"
        },
        {
          "value": "environmental",
          "label": "environmental"
        },
        {
          "value": "civic",
          "label": "civic"
        },
        {
          "value": "other",
          "label": "other"
        }
      ],
      "show_if": {
        "verdict": ["YES", "BORDERLINE"]
      }
    },
    {
      "field": "scope",
      "label": "Scope",
      "type": "enum",
      "options": [
        {
          "value": "national",
          "label": "national"
        },
        {
          "value": "regional",
          "label": "regional"
        },
        {
          "value": "local",
          "label": "local"
        }
      ],
      "show_if": {
        "verdict": ["YES", "BORDERLINE"]
      }
    },
    {
      "field": "repression",
      "label": "Repression",
      "type": "enum",
      "options": [
        {
          "value": "none",
          "label": "none"
        },
        {
          "value": "detentions",
          "label": "detentions"
        },
        {
          "value": "dispersal",
          "label": "dispersal"
        },
        {
          "value": "violence",
          "label": "violence"
        }
      ],
      "show_if": {
        "verdict": ["YES", "BORDERLINE"]
      }
    },
    {
      "field": "regionid_correct",
      "label": "regionid_publisher matches the event?",
      "type": "enum",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No (federal / wrong region)"
        },
        {
          "value": "cant_tell",
          "label": "Can't tell"
        }
      ],
      "show_if": {
        "verdict": ["YES", "BORDERLINE"]
      }
    }
  ]
}
