{
  "task_id": "protests-random-A",
  "name": "Protests — random eval (100)",
  "version": "2026-06-02",
  "id_field": "item_id",
  "instructions": "REPRESENTATIVE random draw from the Activatica Haiku-classified corpus. Goal: the honest protest-occurrence precision number + the rejection genres (digest/roundup posts, police actions, court news) that need filtering rules. Yellow = Haiku's call. We do NOT need the fine protest-type (rally/demo/picket) here — just: is this a real protest event, and if not, why not. Leave fields blank if correct.",
  "display": [
    {
      "field": "date",
      "label": "Date"
    },
    {
      "field": "region_name",
      "label": "Region",
      "format": "compact"
    },
    {
      "field": "regionid",
      "label": "regionid",
      "format": "compact"
    },
    {
      "field": "city",
      "label": "City",
      "format": "compact"
    },
    {
      "field": "title",
      "label": "Title (RU)",
      "format": "longtext"
    },
    {
      "field": "text",
      "label": "Post text (RU)",
      "format": "longtext"
    },
    {
      "field": "tags",
      "label": "Tags",
      "format": "compact"
    },
    {
      "field": "haiku_protest",
      "label": "Haiku: protest?",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "haiku_type",
      "label": "Haiku: protest_type",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "haiku_type_rus",
      "label": "Haiku: type (RU)",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "haiku_scope",
      "label": "Haiku: scope",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "haiku_regime_crit",
      "label": "Haiku: regime_crit",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "haiku_topic_primary",
      "label": "Haiku: topic_primary",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "haiku_size",
      "label": "Haiku: size",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "haiku_repression",
      "label": "Haiku: repression",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "haiku_certainty",
      "label": "Haiku: certainty",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "id",
      "label": "id",
      "format": "compact"
    }
  ],
  "validation": [
    {
      "field": "verdict",
      "label": "Real protest event?",
      "type": "enum",
      "required": true,
      "options": [
        {
          "value": "YES",
          "label": "YES — real protest",
          "key": "1",
          "tone": "good"
        },
        {
          "value": "NO",
          "label": "NO — not a protest event",
          "key": "2",
          "tone": "bad"
        },
        {
          "value": "BORDERLINE",
          "label": "BORDERLINE",
          "key": "3",
          "tone": "warn"
        },
        {
          "value": "SKIP",
          "label": "SKIP — can't tell",
          "key": "4",
          "tone": "neutral"
        }
      ]
    },
    {
      "field": "rejection_reason",
      "label": "Why not a protest event?",
      "type": "enum",
      "options": [
        {
          "value": "digest_roundup",
          "label": "Digest / roundup of many actions (not one event)",
          "key": "q",
          "tone": "neutral"
        },
        {
          "value": "police_action",
          "label": "Police / arrest action",
          "key": "w",
          "tone": "neutral"
        },
        {
          "value": "court_news",
          "label": "Court / sentencing news",
          "key": "e",
          "tone": "neutral"
        },
        {
          "value": "civil_society_news",
          "label": "NGO / civil society news (not protest)",
          "key": "r",
          "tone": "neutral"
        },
        {
          "value": "not_in_russia",
          "label": "Not in Russia",
          "key": "t",
          "tone": "neutral"
        },
        {
          "value": "rumor",
          "label": "Rumor / announced-only / unconfirmed",
          "key": "y",
          "tone": "neutral"
        },
        {
          "value": "unrelated",
          "label": "Unrelated",
          "key": "u",
          "tone": "neutral"
        },
        {
          "value": "other",
          "label": "Other (use notes)",
          "key": "i",
          "tone": "neutral"
        }
      ],
      "show_if": {
        "verdict": [
          "NO",
          "BORDERLINE"
        ]
      }
    },
    {
      "field": "notes",
      "label": "Notes",
      "type": "textarea",
      "placeholder": "Free text — surprises, edge cases, anything"
    }
  ]
}