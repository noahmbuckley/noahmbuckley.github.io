{
  "task_id": "disaster-D31-stated-date",
  "name": "Disaster D-31 — stated-date validation (75)",
  "version": "2026-09-28",
  "id_field": "item_id",
  "instructions": "Check the LLM's stated_date against the real event date. Read the FPP text, the extracted date and its quoted evidence, then use the Wikipedia/Google links to find when the event actually HAPPENED (the accident/disaster itself -- NOT a trial, sentence, inspection, anniversary or the publication date). Answer YES only if the stated date is the exact event day (or, for multi-day events, the first day). If not exact, answer NO and enter the true date in true_date: the loader then also scores within-3-days agreement from true_date. 'Unsure' if you cannot verify -- don't guess. For a NO, pick the error type. 'Why sampled' tells you which error to look for; it says nothing about whether the date is right.",
  "display": [
    {
      "field": "stratum",
      "label": "tier",
      "format": "tag"
    },
    {
      "field": "extract_confidence",
      "label": "LLM conf.",
      "format": "compact"
    },
    {
      "field": "region",
      "label": "region",
      "format": "compact"
    },
    {
      "field": "disaster_type",
      "label": "type",
      "format": "compact"
    },
    {
      "field": "fpp_month",
      "label": "FPP month (when the FPP digest logged it)",
      "format": "compact"
    },
    {
      "field": "fpp_text",
      "label": "FPP description (RU)",
      "format": "longtext"
    },
    {
      "field": "stated_date",
      "label": "LLM stated date",
      "format": "compact",
      "highlight": "llm"
    },
    {
      "field": "date_offset_note",
      "label": "vs FPP month",
      "format": "compact"
    },
    {
      "field": "date_evidence_quote",
      "label": "LLM date-evidence quote",
      "format": "longtext"
    },
    {
      "field": "extract_summary",
      "label": "LLM summary of the evidence",
      "format": "longtext"
    },
    {
      "field": "evidence_snippets",
      "label": "Independent evidence snippets",
      "format": "longtext"
    },
    {
      "field": "sample_reason",
      "label": "Why sampled",
      "format": "longtext"
    },
    {
      "field": "wiki_search_url",
      "label": "ru.wikipedia search",
      "format": "link"
    },
    {
      "field": "google_search_url",
      "label": "Google search",
      "format": "link"
    }
  ],
  "validation": [
    {
      "field": "true_date",
      "label": "True EVENT date (YYYY-MM-DD; partial ok)",
      "type": "text",
      "placeholder": "Fill whenever you find it, esp. for NO"
    },
    {
      "field": "matches_event",
      "label": "Stated date = exact event day?",
      "type": "enum",
      "required": true,
      "options": [
        {
          "value": "yes",
          "label": "Yes (exact day)",
          "key": "1",
          "tone": "good"
        },
        {
          "value": "no",
          "label": "No",
          "key": "2",
          "tone": "bad"
        },
        {
          "value": "unsure",
          "label": "Unsure / can't verify",
          "key": "3",
          "tone": "neutral"
        }
      ]
    },
    {
      "field": "error_type",
      "label": "If NO: what is the stated date?",
      "type": "enum",
      "show_if": {
        "matches_event": [
          "no"
        ]
      },
      "options": [
        {
          "value": "later_event",
          "label": "Trial / court / sentence / aftermath / anniversary",
          "key": "4",
          "tone": "warn"
        },
        {
          "value": "earlier_or_other_date",
          "label": "Earlier event or other unrelated date",
          "key": "5",
          "tone": "warn"
        },
        {
          "value": "publication_date",
          "label": "Publication / reporting date",
          "key": "6",
          "tone": "warn"
        },
        {
          "value": "wrong_event",
          "label": "Text is about a different incident",
          "key": "7",
          "tone": "warn"
        },
        {
          "value": "small_offset",
          "label": "Same event, off by a few days",
          "key": "8",
          "tone": "neutral"
        }
      ]
    },
    {
      "field": "notes",
      "label": "Notes",
      "type": "textarea",
      "placeholder": "Free text"
    }
  ]
}
